{
  "name": "sso-ident-cdc",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "postgres",
    "database.port": "5432",
    "database.user": "debezium",
    "database.password": "debezium",
    "database.dbname": "sso_ident",
    "plugin.name": "pgoutput",
    "slot.name": "sso_ident_user_cdc_slot",
    "publication.name": "sso_ident_user_cdc_publication",
    "publication.autocreate.mode": "disabled",
    "table.include.list": "public.sso_ident_user_cdc",
    "snapshot.mode": "no_data",
    "topic.prefix": "sso-ident",
    "schema.history.internal": "io.debezium.storage.kafka.history.KafkaSchemaHistory",
    "schema.history.internal.kafka.topic": "schema-history.sso-ident",
    "schema.history.internal.kafka.bootstrap.servers": "redpanda:9092",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "transforms": "unwrap,route",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.add.fields": "op,table,lsn",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "^sso-ident\\.public\\.sso_ident_user_cdc$",
    "transforms.route.replacement": "sso.ident.user_updates.clients"
  }
}
