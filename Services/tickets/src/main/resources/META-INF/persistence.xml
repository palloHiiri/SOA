<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
  <persistence-unit name="tickets" transaction-type="JTA">
    <jta-data-source>java:/jdbc/TicketsDS</jta-data-source>
    <class>com.fuzis.tickets.entity.TicketEntity</class>
    <class>com.fuzis.tickets.entity.VenueEntity</class>
    <class>com.fuzis.tickets.entity.PriceHistoryEntity</class>
    <exclude-unlisted-classes>true</exclude-unlisted-classes>
    <properties>
      <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
      <property name="hibernate.jdbc.time_zone" value="UTC"/>
    </properties>
  </persistence-unit>
</persistence>
